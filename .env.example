ORBYNTIQ_APP_NAME=Orbyntiq
ORBYNTIQ_ENVIRONMENT=development
ORBYNTIQ_DEBUG=true
ORBYNTIQ_LOG_LEVEL=INFO
ORBYNTIQ_API_HOST=127.0.0.1
ORBYNTIQ_API_PORT=8000

# Local LLM
ORBYNTIQ_LLM_PROVIDER=ollama
ORBYNTIQ_LLM_MODEL=qwen3:4b-instruct
ORBYNTIQ_OLLAMA_BASE_URL=http://localhost:11434
ORBYNTIQ_LLM_TIMEOUT_SECONDS=60
ORBYNTIQ_LLM_MAX_RETRIES=2
ORBYNTIQ_LLM_RETRY_BASE_DELAY_SECONDS=0.5

# Redis
ORBYNTIQ_REDIS_URL=redis://localhost:6379/0
ORBYNTIQ_REDIS_CONNECT_TIMEOUT_SECONDS=2
ORBYNTIQ_REDIS_OPERATION_TIMEOUT_SECONDS=2
ORBYNTIQ_REDIS_SESSION_TTL_SECONDS=86400
ORBYNTIQ_REDIS_CONVERSATION_TTL_SECONDS=21600
ORBYNTIQ_REDIS_AGENT_STATE_TTL_SECONDS=3600
ORBYNTIQ_REDIS_CACHE_TTL_SECONDS=300

# MongoDB
ORBYNTIQ_MONGODB_URL=mongodb://localhost:27017
ORBYNTIQ_MONGODB_DATABASE=orbyntiq
ORBYNTIQ_MONGODB_CONNECT_TIMEOUT_SECONDS=3
ORBYNTIQ_MONGODB_SERVER_SELECTION_TIMEOUT_SECONDS=3
ORBYNTIQ_MONGODB_OPERATION_TIMEOUT_SECONDS=5
